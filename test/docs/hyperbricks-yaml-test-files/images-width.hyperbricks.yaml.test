  "Loading": "",
  "MetaDocDescription": "",
  "Quality": 0,
  "Src": "hyperbricks-test-files/assets/cute_cat.jpg",
  "Title": "",
  "Width": 330
}

==== expected output ====
<img src="static/images/cute_cat_w330_h330.jpg" width="330" height="330" /> 
