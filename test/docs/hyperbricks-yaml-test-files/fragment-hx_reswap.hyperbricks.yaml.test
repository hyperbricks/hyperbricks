  "HxLocation": "",
  "HxPushedUrl": "",
  "HxRedirect": "",
  "HxRefresh": "",
  "HxReplaceUrl": "",
  "HxReselect": "",
  "HxResponseWriter": null,
  "HxReswap": "innerHTML",
  "HxRetarget": "",
  "HxTemplateResult": "",
  "HxTrigger": "",
  "HxTriggerafterSettle": "",
  "HxTriggerafterSwap": "",
  "HyperBricksFile": "",
  "HyperBricksKey": "",
  "HyperBricksPath": "",
  "Index": 0,
  "Items": null,
