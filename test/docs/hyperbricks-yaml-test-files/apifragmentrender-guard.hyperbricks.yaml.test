==== hyperbricks yaml {!{api_fragment}} ====
api_fragment:
  - type: api_fragment_render
  - endpoint: https://example.com/fragment
  - guard:
      auth:
        cookie: token
      authorize:
        endpoint: https://example.com/authorize?project=$project
        headers:
          Accept: application/json
        method: GET
      enabled: "true"
      on_forbidden:
        default:
          status: 303
          headers:
            Location: /forbidden
        variants:
          - when:
              request_headers:
                HX-Request: "true"
            response:
              status: "403"
              headers:
                HX-Redirect: /forbidden
      on_unauthenticated:
        default:
          status: 303
          headers:
            Location: /login
        variants:
          - when:
              request_headers:
                HX-Request: "true"
            response:
              status: "401"
              headers:
                HX-Redirect: /login
      require:
        authenticated: "true"
        query:
          project: "true"
  - method: GET
  - route: protected-api-fragment
==== explainer ====
Optional pre-render route guard. When omitted or disabled, current API_FRAGMENT_RENDER behavior remains unchanged
