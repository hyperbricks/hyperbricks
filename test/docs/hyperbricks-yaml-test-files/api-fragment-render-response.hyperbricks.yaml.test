==== hyperbricks yaml {!{api_fragment}} ====
api_fragment:
  - type: api_fragment_render
  - endpoint: https://example.com/fragment
  - method: GET
  - response:
      headers:
        HX-Trigger: myEvent
  - route: api-fragment
