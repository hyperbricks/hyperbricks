==== hyperbricks yaml {!{api_render}} ====
api_render:
  - type: api_render
  - body: '{"foo":"bar"}'
  - endpoint: https://example.com/api
  - method: GET
==== explainer ====
Raw request body. Use a scalar string value; nested objects are not parsed for this field.
==== expected json ====
{
  "AllowedQueryKeys": null,
  "Body": "{\"foo\":\"bar\"}",
  "ConfigCategory": "",
  "ConfigType": "<API_RENDER>",
  "Debug": false,
  "DebugPanel": false,
  "Enclose": "",
  "Endpoint": "https://example.com/api",
  "ExtraAttributes": null,
  "Headers": null,
  "HyperBricksFile": "",
  "HyperBricksKey": "",
  "HyperBricksPath": "",
  "Inline": "",
  "JwtClaims": null,
  "JwtSecret": "",
  "MetaDocDescription": "",
  "Method": "GET",
  "Password": "",
  "QueryParams": null,
  "Status": 0,
  "Template": "",
  "Username": "",
  "Values": null
}

