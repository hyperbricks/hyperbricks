  "Template": null,
  "Title": ""
}

==== expected output ====
<!DOCTYPE html><html><head>
<style>
    body {
        padding:20px;
    }
</style>
<style>

.content {
    color:green;
}

</style><meta name="generator" content="hyperbricks runtime"></head><body><p>SOME CONTENT</p></body></html>
