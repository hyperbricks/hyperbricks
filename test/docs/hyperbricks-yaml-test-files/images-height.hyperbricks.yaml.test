  "ExtraAttributes": null,
  "Height": 100,
  "HyperBricksFile": "",
  "HyperBricksKey": "",
  "HyperBricksPath": "",
  "Id": "",
  "IsStatic": false,
  "Loading": "",
  "MetaDocDescription": "",
  "Quality": 0,
  "Src": "hyperbricks-test-files/assets/cute_cat.jpg",
  "Title": "",
  "Width": 0
}

==== expected output ====
<img src="static/images/cute_cat_w100_h100.jpg" width="100" height="100" /> 
