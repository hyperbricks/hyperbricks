==== hyperbricks yaml {!{fragment}} ====
fragment:
  - type: fragment
  - content:
      - type: tree
      - template_10:
          - type: template
          - inline: "\n<iframe width=\"{{.width}}\" height=\"{{.height}}\" src=\"{{.src}}\"></iframe>\n    "
          - values:
              height: "400"
              src: https://www.youtube.com/watch?v=Wlh6yFSJEms
              width: "300"
      - template_20:
          - type: template
          - inline: "\n<iframe width=\"{{.width}}\" height=\"{{.height}}\" src=\"{{.src}}\"></iframe>\n    "
          - values:
              height: "400"
              src: https://www.youtube.com/embed/tgbNymZ7vqY
              width: "300"
      - enclose: <div class="youtube_video">|</div>
myComponent:
  - type: template
  - inline: "\n<iframe width=\"{{.width}}\" height=\"{{.height}}\" src=\"{{.src}}\"></iframe>\n    "
  - values:
      height: "400"
      src: https://www.youtube.com/embed/tgbNymZ7vqY
      width: "300"
