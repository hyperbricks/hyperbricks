==== hyperbricks yaml {!{hypermedia}} ====
hypermedia:
  - type: hypermedia
  - head:
      - type: head
      - css_10:
          - type: css
          - link: styles.css
==== explainer ====
Use link for a link tag to a css file.
==== expected json ====
{
  "BodyTag": "",
  "Cache": "",
  "ConfigCategory": "",
  "ConfigType": "<HYPERMEDIA>",
  "ContentType": "",
  "Cookies": null,
  "Doctype": "",
  "Enclose": "",
  "Favicon": "",
  "Head": {
    "@order": [
      "css_10"
    ],
    "@type": "<HEAD>",
    "css_10": {
      "@type": "<CSS>",
      "link": "styles.css"
    }
  },
  "Headers": null,
  "HtmlTag": "",
  "HyperBricksFile": "",
  "HyperBricksKey": "",
  "HyperBricksPath": "",
  "Index": 0,
  "Items": null,
  "MetaDocDescription": "",
  "NoCache": false,
