  "Head": {
    "10": {
      "@type": "<JAVASCRIPT>",
      "attributes": {
        "type": "text/javascript"
      },
      "file": "hyperbricks-yaml-test-files/assets/main.js"
    }
  },
  "Headers": null,
  "HtmlTag": "",
  "HyperBricksFile": "",
  "HyperBricksKey": "",
  "HyperBricksPath": "",
  "Index": 0,
  "Items": null,
  "MetaDocDescription": "",
  "NoCache": false,
  "Route": "",
  "Section": "",
  "Static": "",
  "Template": null,
