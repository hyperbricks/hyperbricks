==== hyperbricks yaml {!{fragment}} ====
fragment:
  - type: fragment
  - guard:
      auth:
        cookie: token
      authorize:
        endpoint: https://example.com/authorize?project=$project
        headers:
          Accept: application/json
        method: GET
      enabled: "true"
      on_forbidden:
        default:
          status: 303
          headers:
            Location: /forbidden
        variants:
          - when:
              request_headers:
                HX-Request: "true"
            response:
              status: "403"
              headers:
                HX-Redirect: /forbidden
      on_unauthenticated:
        default:
          status: 303
          headers:
            Location: /login
        variants:
          - when:
              request_headers:
                HX-Request: "true"
            response:
              status: "401"
              headers:
                HX-Redirect: /login
      require:
        authenticated: "true"
        query:
          project: "true"
  - route: protected-fragment
==== explainer ====
Optional pre-render route guard. When omitted or disabled, current FRAGMENT behavior remains unchanged
