==== hyperbricks yaml {!{fragment}} ====
fragment:
  - type: fragment
  - content:
      - type: tree
      - template_10:
          - type: template
          - inline: "\n<h1>{{.header}}</h1>\n<p>{{.text}}</p>\n    "
          - values:
              header: hello world!
              text: some text
      - enclose: <div class="sometext">|</div>
myComponent:
  - type: template
  - inline: "\n<h1>{{.header}}</h1>\n<p>{{.text}}</p>\n    "
  - values:
      header: hello world!
      text: some text
