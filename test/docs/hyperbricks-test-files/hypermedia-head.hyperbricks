  "HtmlTag": "",
  "Head": {
    "1001": {
      "@type": "<CSS>",
      "inline": "\nbody {\n  padding:10px;\n}\n    "
    },
    "20": {
      "@type": "<HTML>",
      "value": "<meta name=\"generator\" content=\"hyperbricks runtime\">"
    },
    "999": {
