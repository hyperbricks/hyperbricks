==== hyperbricks config {!{fragment}} ====
fragment = <FRAGMENT>
fragment {
    route = protected-fragment
    guard {
        enabled = true
        auth {
            cookie = token
        }
        require {
            authenticated = true
            query {
                project = true
            }
        }
        authorize {
            endpoint = https://example.com/authorize?project=$project
            method = GET
            headers {
                Accept = application/json
            }
        }
        on_unauthenticated {
            redirect = /login
            hx_redirect = /login
            status = 401
        }
        on_forbidden {
            redirect = /forbidden
            hx_redirect = /forbidden
            status = 403
        }
    }
}
==== explainer ====
Optional pre-render route guard. When omitted or disabled, current FRAGMENT behavior remains unchanged
