==== hyperbricks yaml {!{profileTemplate}} ====
profileTemplate:
  - type: template
  - inline: |
      <div>
        <h3>{{ .username | default "Anonymous" }}</h3>
        {{ if .bio }}
          <p>{{ .bio }}</p>
        {{ else }}
          <p>No bio provided.</p>
        {{ end }}
      </div>
  - values:
      title: Profile
      bio: ""
==== expected output ====
<div>
  <h3>Anonymous</h3>
  <p>No bio provided.</p>
</div>
