==== hyperbricks yaml {!{api_test}} ====
api_test:
  - type: api_fragment_render
  - route: index
  - endpoint: http://localhost:3000/tasks
  - method: GET
  - querykeys:
      - id
      - order
  - values:
      postgrest_url: http://localhost:3000/
  - headers:
      Access-Control-Allow-Credentials: "true"
      Authorization:
        format: "Bearer %s"
        args:
          - env:
              name: PGRST_TEST_USER_JWT
              required: true
      Content-Type: application/json
  - inline: |
      {{if gt (len .Data) 0}}
        <p>Tasklist has item(s)</p>
      {{else}}
        <p>Tasklist is empty</p>
      {{end}}
==== expected output ====
<p>Tasklist has item(s)</p>
