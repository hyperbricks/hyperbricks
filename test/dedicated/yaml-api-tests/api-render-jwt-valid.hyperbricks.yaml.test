==== hyperbricks yaml {!{echo_jwt_works}} ====
echo_jwt_works:
  - type: api_render
  - route: index
  - endpoint: http://localhost:8090/echo/token/validate
  - method: POST
  - jwtsecret:
      env:
        name: PGRST_JWT_SECRET
        required: true
  - jwtclaims:
      sub: user
  - inline: |
      {{if .Data.valid}}GOOD{{else}}FAIL{{end}}
==== expected output ====
GOOD
