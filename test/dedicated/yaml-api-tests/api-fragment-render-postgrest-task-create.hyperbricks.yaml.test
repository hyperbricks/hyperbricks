==== hyperbricks yaml {!{user_add_task}} ====
user_add_task:
  - type: api_fragment_render
  - route: index
  - endpoint: http://localhost:3000/tasks
  - method: POST
  - body: '{"title":"Dit is een test"}'
  - querykeys:
      - id
  - headers:
      Access-Control-Allow-Credentials: "true"
      Authorization: Bearer eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiIDogIjEiLCAicm9sZSIgOiAiYXV0aGVudGljYXRlZCJ9.AW7K8SMa3KpCXMpOte1H82-iM0OGTJhB2MH2-0ADdnA
      Content-Type: application/json
  - inline: |
      {{ if eq .Status 201 }}created{{ else }}failed{{ end }}
  - response:
      headers:
        HX-Trigger: update_list
