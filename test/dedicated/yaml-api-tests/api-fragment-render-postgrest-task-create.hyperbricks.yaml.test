==== hyperbricks yaml {!{user_add_task}} ====
user_add_task:
  - type: api_fragment_render
  - route: index
  - endpoint: http://localhost:3000/tasks
  - method: POST
  - body: '{"title":"Dit is een test"}'
  - querykeys:
      - id
  - headers:
      Access-Control-Allow-Credentials: "true"
      Authorization:
        format: "Bearer %s"
        args:
          - env:
              name: PGRST_TEST_USER_JWT
              required: true
      Content-Type: application/json
  - inline: |
      {{ if eq .Status 201 }}created{{ else }}failed{{ end }}
  - response:
      headers:
        HX-Trigger: update_list
==== expected output ====
created
